  "steering": {
    "groups": [
      {
        "id": "style",
        "title": "Code style",
        "rules": [
          {
            "id": "r1",
            "label": "Semicolons required",
            "on": true,
            "kind": "toggle"
          },
          {
            "id": "r2",
            "label": "Single quotes for strings",
            "on": true,
            "kind": "toggle"
          },
          {
            "id": "r3",
            "label": "Max line length",
            "on": true,
            "kind": "slider",
            "value": 100,
            "min": 60,
            "max": 140,
            "step": 10
          }
        ]
      },
      {
        "id": "arch",
        "title": "Architecture",
        "rules": [
          {
            "id": "r4",
            "label": "Money as integer cents (no floats)",
            "on": true,
            "kind": "toggle"
          },
          {
            "id": "r5",
            "label": "All external calls must be idempotent",
            "on": true,
            "kind": "toggle"
          },
          {
            "id": "r6",
            "label": "Repository pattern for data access",
            "on": false,
            "kind": "toggle"
          }
        ]
      },
      {
        "id": "naming",
        "title": "Naming",
        "rules": [
          {
            "id": "r7",
            "label": "camelCase functions, PascalCase types",
            "on": true,
            "kind": "toggle"
          },
          {
            "id": "r8",
            "label": "Boolean names start with is/has/should",
            "on": true,
            "kind": "toggle"
          }
        ]
      }
    ],
    "exceptions": [
      {
        "id": "x1",
        "rule": "Max line length",
        "scope": "src/migrations/**",
        "note": "SQL strings exceed 100 cols"
      }
    ],
    "sample": "function calc_total(items){\n  var total = 0.0\n  for(i=0;i<items.length;i++){\n    total = total + items[i].price\n  }\n  return total\n}"
  }
}
